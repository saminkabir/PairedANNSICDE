+// ---------------------------------------------------------------------------
+// Shared (external) storage support.
+//
+// `storage` may be:
+//   * a faiss.IndexFlat / IndexFlatL2 / IndexFlatIP  -> zero-copy view of its codes
+//   * any faiss index with a flat `.storage` (IndexHNSWFlat, IndexNSGFlat, ...)
+//   * a C-contiguous 2D numpy array of the index's element type
+// Nothing is ever copied: if the input is not already in the right layout we
+// raise instead of silently making a private copy (which would defeat sharing).
+// ---------------------------------------------------------------------------
+struct ResolvedStorage {
+  const void* data = nullptr;
+  size_t rows = 0;
+  size_t cols = 0;
+  size_t row_bytes = 0;
+  py::object array;  // keeps the numpy view alive
+  py::object owner;  // the faiss index (if any) that owns the memory
+  bool is_faiss = false;
+};
+
+inline ResolvedStorage resolveExternalStorage(py::object storage, DataType data_type, int dim,
+                                              const std::string& distance_type) {
+  ResolvedStorage out;
+  out.owner = storage;
+  py::object array = storage;
+
+  bool looks_like_faiss = py::hasattr(storage, "ntotal") && py::hasattr(storage, "d");
+  if (looks_like_faiss) {
+    py::module_ faiss = py::module_::import("faiss");
+    py::object flat = storage;
+    if (!py::hasattr(flat, "get_xb")) {
+      // e.g. IndexHNSWFlat / IndexNSGFlat: use their flat storage.
+      if (py::hasattr(flat, "storage")) {
+        flat = faiss.attr("downcast_index")(flat.attr("storage"));
+      } else {
+        flat = faiss.attr("downcast_index")(flat);
+      }
+    }
+    if (!py::hasattr(flat, "get_xb")) {
+      throw std::invalid_argument(
+          "external_storage: faiss index has no flat float storage (need IndexFlat / IndexFlatL2 / "
+          "IndexFlatIP, or an index whose .storage is one).");
+    }
+    if (data_type != DataType::float32) {
+      throw std::invalid_argument("external_storage: faiss IndexFlat stores float32; create the index with "
+                                  "index_data_type=float32.");
+    }
+    // Metric check: FlatNav "l2" <-> faiss METRIC_L2, "angular" <-> METRIC_INNER_PRODUCT.
+    if (py::hasattr(flat, "metric_type")) {
+      int metric = flat.attr("metric_type").cast<int>();
+      int want = (distance_type == "l2") ? faiss.attr("METRIC_L2").cast<int>()
+                                         : faiss.attr("METRIC_INNER_PRODUCT").cast<int>();
+      if (metric != want) {
+        throw std::invalid_argument("external_storage: metric mismatch between the faiss storage and the "
+                                    "FlatNav distance_type `" +
+                                    distance_type + "`.");
+      }
+    }
+    size_t ntotal = flat.attr("ntotal").cast<size_t>();
+    size_t d = flat.attr("d").cast<size_t>();
+    if (ntotal == 0) {
+      throw std::invalid_argument("external_storage: the faiss storage is empty. Add the vectors to it first.");
+    }
+    array = faiss.attr("rev_swig_ptr")(flat.attr("get_xb")(), ntotal * d).attr("reshape")(ntotal, d);
+    out.owner = flat;
+    out.is_faiss = true;
+  }
+
+  if (!py::isinstance<py::array>(array)) {
+    throw std::invalid_argument(
+        "external_storage must be a faiss IndexFlat (or an index with a flat .storage) or a 2D numpy array.");
+  }
+  py::array arr = array.cast<py::array>();
+  if (arr.ndim() != 2 || arr.shape(1) != dim) {
+    throw std::invalid_argument("external_storage must have shape (n, " + std::to_string(dim) + ").");
+  }
+  if (!(arr.flags() & py::array::c_style)) {
+    throw std::invalid_argument("external_storage must be C-contiguous (it is shared, not copied).");
+  }
+  bool dtype_ok = (data_type == DataType::float32 && py::isinstance<py::array_t<float>>(arr)) ||
+                  (data_type == DataType::int8 && py::isinstance<py::array_t<int8_t>>(arr)) ||
+                  (data_type == DataType::uint8 && py::isinstance<py::array_t<uint8_t>>(arr));
+  if (!dtype_ok) {
+    throw std::invalid_argument("external_storage dtype does not match index_data_type (no implicit copy).");
+  }
+  out.data = arr.data();
+  out.rows = static_cast<size_t>(arr.shape(0));
+  out.cols = static_cast<size_t>(arr.shape(1));
+  out.row_bytes = static_cast<size_t>(arr.strides(0));
+  out.array = arr;
+  return out;
+}
